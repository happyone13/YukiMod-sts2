<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>packages/**</DefaultItemExcludes>
    <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
    <PathMap>$(AppOutputBase)=.\</PathMap>
    <Sts2TargetVersion Condition="'$(Sts2TargetVersion)' == ''">107</Sts2TargetVersion>
    <RitsuLibVersion Condition="'$(RitsuLibVersion)' == ''">0.4.54</RitsuLibVersion>
  </PropertyGroup>

  <PropertyGroup>
    <IsWindows>false</IsWindows>
    <IsLinux>false</IsLinux>
    <IsOSX>false</IsOSX>
    <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
    <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
    <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindows)' == 'true'">
    <AutoSteamPath>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
    <SteamLibraryPath Condition="Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>
    <GodotPath Condition="Exists('H:/Trae_home/ChaosMod/Godot_v4.5.1/Godot_v4.5.1-stable_mono_win64.exe')">H:/Trae_home/ChaosMod/Godot_v4.5.1/Godot_v4.5.1-stable_mono_win64.exe</GodotPath>
    <GodotPath Condition="'$(GodotPath)' == ''">E:\SOFT\godot\Godot_v4.5.1-stable_mono_win64/Godot_v4.5.1-stable_mono_win64.exe</GodotPath>
    <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">C:/Program Files (x86)/Steam/steamapps</SteamLibraryPath>
    <Sts2Path107 Condition="'$(Sts2Path107)' == '' and '$(STS2_107_PATH)' != ''">$(STS2_107_PATH)</Sts2Path107>
    <Sts2Path107 Condition="'$(Sts2Path107)' == '' and Exists('H:/SteamLibrary/steamapps/common/Slay the Spire 2')">H:/SteamLibrary/steamapps/common/Slay the Spire 2</Sts2Path107>
    <Sts2Path107 Condition="'$(Sts2Path107)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path107>
    <Sts2Path108 Condition="'$(Sts2Path108)' == '' and '$(STS2_108_PATH)' != ''">$(STS2_108_PATH)</Sts2Path108>
    <Sts2Path108 Condition="'$(Sts2Path108)' == '' and Exists('H:/SteamLibrary/steamapps/common/Slay the Spire 2')">H:/SteamLibrary/steamapps/common/Slay the Spire 2</Sts2Path108>
    <Sts2Path108 Condition="'$(Sts2Path108)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path108>
    <Sts2Path Condition="'$(Sts2TargetVersion)' == '107'">$(Sts2Path107)</Sts2Path>
    <Sts2Path Condition="'$(Sts2TargetVersion)' == '108'">$(Sts2Path108)</Sts2Path>
    <LocalModsDirName Condition="'$(LocalModsDirName)' == '' and Exists('$(Sts2Path)/mods2')">mods2</LocalModsDirName>
    <LocalModsDirName Condition="'$(LocalModsDirName)' == ''">mods</LocalModsDirName>
    <ModsPath>$(Sts2Path)/$(LocalModsDirName)/</ModsPath>
    <LegacyModsPath>$(Sts2Path)/mods/</LegacyModsPath>
    <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLinux)' == 'true'">
    <SteamLibraryPath>$(HOME)/.local/share/Steam/steamapps</SteamLibraryPath>
    <GodotPath>$(SteamLibraryPath)/common/Godot Engine/godot.x11.opt.tools.64</GodotPath>
    <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
    <ModsPath>$(Sts2Path)/mods/</ModsPath>
    <Sts2DataDir>$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsOSX)' == 'true'">
    <SteamLibraryPath>$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
    <GodotPath>$(HOME)/Applications/Godot_mono.app/Contents/MacOS/Godot</GodotPath>
    <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
    <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
    <Sts2DataDir>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <DefineConstants Condition="'$(Sts2TargetVersion)' == '107'">$(DefineConstants);STS2_107</DefineConstants>
    <DefineConstants Condition="'$(Sts2TargetVersion)' == '108'">$(DefineConstants);STS2_108</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(Sts2DataDir)') and '$(Configuration)' == 'Debug'">
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(Sts2DataDir)') and '$(Configuration)' != 'Debug'">
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="STS2.RitsuLib" Version="$(RitsuLibVersion)" GeneratePathProperty="true" PrivateAssets="All" />
    <AdditionalFiles Include="YukiMod/localization/**/*.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="YukiMod/**" />
    <Compile Remove=".godot/**" />
    <Compile Remove="tmp/**" />
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
    <Compile Remove="materials/**" />
    <Compile Remove="shaders/**" />
    <Compile Remove="images/**" />
    <EmbeddedResource Remove="YukiMod/**" />
    <EmbeddedResource Remove=".godot/**" />
    <EmbeddedResource Remove="tmp/**" />
    <EmbeddedResource Remove="tests/**" />
    <EmbeddedResource Remove="tools/**" />
    <EmbeddedResource Remove="materials/**" />
    <EmbeddedResource Remove="shaders/**" />
    <EmbeddedResource Remove="images/**" />
    <None Remove="tmp/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".gitignore" />
    <None Include="YukiMod.json" />
    <None Include="project.godot" />
    <None Include="YukiMod/**" />
  </ItemGroup>

  <Target Name="CheckDependencyPaths">
    <Error
      Text=" Unsupported Sts2TargetVersion '$(Sts2TargetVersion)'. Use 107 or 108."
      Condition="'$(Sts2TargetVersion)' != '107' and '$(Sts2TargetVersion)' != '108'" />
    <Error
      Text=" Sts2Path107 is not configured. Pass -p:Sts2Path107=&lt;path&gt; or set STS2_107_PATH when building 107."
      Condition="'$(Sts2TargetVersion)' == '107' and '$(Sts2Path107)' == ''" />
    <Error
      Text=" Sts2Path108 is not configured. Pass -p:Sts2Path108=&lt;path&gt; or set STS2_108_PATH when building 108."
      Condition="'$(Sts2TargetVersion)' == '108' and '$(Sts2Path108)' == ''" />
    <Error
      Text=" Slay the Spire 2 $(Sts2TargetVersion) data not found at path '$(Sts2DataDir)'"
      Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    <Error
      Text=" Godot not found at path '$(GodotPath)'"
      Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')" />
  </Target>

  <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
    <Message Text="Copying .dll and manifest to mods folder." Importance="high" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
    <Copy SourceFiles="YukiMod.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LegacyModsPath)$(MSBuildProjectName)/" Condition="'$(LegacyModsPath)' != '' and '$(LegacyModsPath)' != '$(ModsPath)'" />
    <Copy SourceFiles="YukiMod.json" DestinationFolder="$(LegacyModsPath)$(MSBuildProjectName)/" Condition="'$(LegacyModsPath)' != '' and '$(LegacyModsPath)' != '$(ModsPath)'" />
  </Target>

  <Target Name="MirrorGodotPackToLegacyModsFolder" AfterTargets="GodotPackOnBuild;GodotPublish" Condition="'$(LegacyModsPath)' != '' and '$(LegacyModsPath)' != '$(ModsPath)' and Exists('$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck')">
    <Message Text="Mirroring Godot .pck to legacy mods folder for test loaders" Importance="high" />
    <Copy SourceFiles="$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck" DestinationFolder="$(LegacyModsPath)$(MSBuildProjectName)/" />
  </Target>

  <Target
    Name="GodotPackOnBuild"
    AfterTargets="Build"
    Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
    <Message Text="Exporting Godot .pck to mods folder on Build" Importance="high" />
    <Exec
      Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
      EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;STS2_107_PATH=$(Sts2Path107);STS2_108_PATH=$(Sts2Path108)"
      ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
    <Message Text="Exporting Godot .pck to mods folder" Importance="high" />
    <Exec
      Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
      EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;STS2_107_PATH=$(Sts2Path107);STS2_108_PATH=$(Sts2Path108)"
      ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="GodotPublishSkipped" AfterTargets="Publish" Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')">
    <Message Text="Skipping Godot .pck export because GodotPath is not configured." Importance="high" />
  </Target>
</Project>
